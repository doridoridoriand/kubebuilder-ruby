#!/usr/bin/env ruby
# frozen_string_literal: true

require "kruby-controller"

command = ARGV.shift

begin
  case command
  when "init"
    KrubyController::CLI::InitCommand.new(ARGV).run
  when "create"
    subcommand = ARGV.shift
    case subcommand
    when "api"
      KrubyController::CLI::CreateApiCommand.new(ARGV).run
    else
      warn "Unknown create subcommand: #{subcommand.inspect}"
      warn "Usage: kruby-controller create api --group <G> --kind <K>"
      exit 1
    end
  when nil, "-h", "--help"
    puts "Usage: kruby-controller {init|create api}"
  else
    warn "Unknown command: #{command.inspect}"
    warn "Usage: kruby-controller {init|create api}"
    exit 1
  end
rescue KrubyController::CLI::UsageError => e
  warn e.message
  exit 1
end
